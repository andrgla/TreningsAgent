{
  "mcpServers": {
    "calendar": {
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/servers/calendar_mcp.py"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/servers",
        "APPLE_BRIDGE_BIN": "${workspaceFolder}/node_modules/apple-calendar-mcp/swift/.build/release/apple-bridge",
        "TRAINING_CALENDAR_NAME": "Trening"
      }
    },
    "garmin": {
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/servers/garmin_mcp.py"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/servers",
        "GARMINTOKENS": "${workspaceFolder}/data/.garminconnect"
      },
      "envFile": "${workspaceFolder}/.env"
    },
    "sio-gym": {
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/servers/sio_gym_mcp.py"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/servers"
      },
      "envFile": "${workspaceFolder}/.env"
    },
    "notion": {
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "${workspaceFolder}/servers/notion_mcp.py"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "envFile": "${workspaceFolder}/.env"
    }
  }
}
