# Copy this file to `.env` and fill in your details. `.env` is gitignored.
#
# The scheduled cloud jobs read the same names from GitHub repository secrets —
# `./scripts/sync_github_secrets.sh` uploads this file for you.

# --- Garmin Connect (read only) ---
GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=your-garmin-password

# --- SiO Athletica (iBooking) ---
# Your SiO login is your MOBILE NUMBER (username_type = mobile).
SIO_USERNAME=4712345678
SIO_PASSWORD=your-sio-password

# Safety gate: booking/cancelling is OFF unless this is exactly "true".
# Leave empty while testing so the agent can only READ the schedule.
SIO_ALLOW_BOOKING=

# --- Calendar ---
# Only this calendar accepts agent writes (create/delete). Alias also accepted:
# CALENDAR_WRITABLE_NAME=Trening
TRAINING_CALENDAR_NAME=Trening

# Backend: "apple" (macOS EventKit, no secrets, needs a Calendar permission
# prompt) or "caldav" (iCloud over HTTPS, works anywhere). Leave empty to pick
# automatically — EventKit on a Mac, CalDAV everywhere else.
CALENDAR_BACKEND=

# iCloud CalDAV — required for the scheduled cloud jobs, which cannot use
# EventKit. Create an app-specific password at appleid.apple.com →
# Sign-In and Security → App-Specific Passwords. Your regular Apple ID password
# will NOT work. The Trening calendar must live in iCloud, not "On My Mac".
ICLOUD_USERNAME=your@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Notion (Workout Coach program) ---
# https://www.notion.so/my-integrations → New integration → copy Internal Integration Secret
# Share YOUR Workout Coach page with the integration (⋯ → Connect to).
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Required: your Workout Coach page id (from the Notion URL, 32 hex chars).
NOTION_WORKOUT_COACH_PAGE_ID=

# --- Headless coach automation (optional) ---
# Only needed for the coach-weekly / coach-quarterly scheduled jobs, which run a
# Claude Code agent to generate calendar sessions + the next quarter plan.
# Create a key at https://console.anthropic.com
# Also needs: npm install -g @anthropic-ai/claude-code
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional model override (default: claude-opus-5):
# COACH_AGENT_MODEL=claude-opus-5
