{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./data/.garminconnect/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/hooks/garmin_guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for a running Garmin process"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/hooks/secret_guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for credential leaks"
          }
        ]
      }
    ]
  }
}
